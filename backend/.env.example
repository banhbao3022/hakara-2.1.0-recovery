# Singora Karaoke Backend — Production Environment Configuration
PORT=3000
DB_PATH=./data/singora.db

# Request Signature Verification (matches Android Interceptor2.java)
# Set ENFORCE_SIG=true in production and supply APP_HMAC_KEY from NativeUtils.getKeyApp()
ENFORCE_SIG=false
APP_HMAC_KEY=

# CORS & Upload Limits
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=52428800

# Rate Limiting (per IP per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_WRITE_MAX=120
