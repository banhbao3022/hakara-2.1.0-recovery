<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="50.0dp" />
            <solid android:color="@color/btn_gray_solid" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <corners android:radius="50.0dp" />
            <gradient android:startColor="@color/btn_gray_start" android:endColor="@color/btn_gray_end" android:angle="180.0" />
        </shape>
    </item>
</selector>
