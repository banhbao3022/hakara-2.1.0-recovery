<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RelativeLayout android:id="@id/layout_select_watermark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/setting_page_margin_top">
            <TextView android:textSize="16.0sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/select_watermark" android:layout_centerVertical="true" android:layout_marginStart="@dimen/setting_page_margin_start" android:layout_alignParentStart="true" />
            <ImageView android:background="@drawable/ic_settings_arrow_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="@dimen/setting_page_margin_end" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <View android:background="@color/dimgray" android:layout_width="match_parent" android:layout_height="1.0px" android:layout_marginTop="@dimen/setting_page_margin_top" />
        <RelativeLayout android:id="@id/layout_show_face_points" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/setting_page_margin_top">
            <TextView android:textSize="16.0sp" android:id="@id/tv_show_face_points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_face_points" android:layout_centerVertical="true" android:layout_marginStart="@dimen/setting_page_margin_start" android:layout_alignParentStart="true" />
            <ImageView android:background="@drawable/ic_settings_arrow_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="@dimen/setting_page_margin_end" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <View android:background="@color/dimgray" android:layout_width="match_parent" android:layout_height="1.0px" android:layout_marginTop="@dimen/setting_page_margin_top" />
        <RelativeLayout android:id="@id/layout_show_fps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/setting_page_margin_top">
            <TextView android:textSize="16.0sp" android:id="@id/tv_show_fps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/show_fps" android:layout_centerVertical="true" android:layout_marginStart="@dimen/setting_page_margin_start" android:layout_alignParentStart="true" />
            <ImageView android:background="@drawable/ic_settings_arrow_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginEnd="@dimen/setting_page_margin_end" android:layout_alignParentEnd="true" />
        </RelativeLayout>
        <View android:background="@color/dimgray" android:layout_width="match_parent" android:layout_height="1.0px" android:layout_marginTop="@dimen/setting_page_margin_top" />
    </LinearLayout>
</ScrollView>
