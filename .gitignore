# Rebuilt and test APK/AAB binaries & private keystores
*.apk
*.aab
*.idsig
*.keystore
*.jks
/keystore/
/dist-singora/

# Duplicate / raw smali & dex dumps (~685 MB)
/emulator-test-apktool/
/singora-apktool/
/extracted/apktool/
/extracted/jadx/

# Backend runtime SQLite DB, node_modules, and generated media/uploads
/backend/node_modules/
/backend/data/
/backend/public/uploads/
/backend/public/media/
/notes/*.xml
/notes/*.png

# Large prebuilt third-party native .so binaries (>100 MB) in android-project
# (Copied locally from emulator-test-apktool/lib; keep custom libAudioEngine.so tracked!)
/android-project/app/src/main/jniLibs/*/*.so
!/android-project/app/src/main/jniLibs/*/libAudioEngine.so
!/android-project/app/src/main/jniLibs/*/libcainfilter.so
!/android-project/app/src/main/jniLibs/*/libffcommand.so
!/android-project/app/src/main/jniLibs/*/libffrecorder.so
!/android-project/app/src/main/jniLibs/*/libmedia_editor.so
!/android-project/app/src/main/jniLibs/*/libmedia_player.so
!/android-project/app/src/main/jniLibs/*/libmetadata_retriever.so
!/android-project/app/src/main/jniLibs/*/libmusicplayer.so
!/android-project/app/src/main/jniLibs/*/libnativefilter.so
!/android-project/app/src/main/jniLibs/*/libsoundtouch.so
!/android-project/app/src/main/jniLibs/*/libvideoplayer.so

