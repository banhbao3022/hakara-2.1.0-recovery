{
  "name": "hakara-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Client-compatible REST backend for Hakara 2.1.0 (mtp.media.karaoke)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:routes": "tsx scripts/check-routes.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.9",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.12",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
