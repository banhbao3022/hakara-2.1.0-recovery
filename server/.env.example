# Copy to .env and adjust. docker-compose.yml reads this file.

PORT=8080
HOST=0.0.0.0

# Postgres. The hostname `db` resolves inside docker compose; use localhost from the host.
DATABASE_URL=postgresql://hakara:hakara@db:5432/hakara?schema=public
POSTGRES_USER=hakara
POSTGRES_PASSWORD=hakara
POSTGRES_DB=hakara
# Host port the db container publishes. Change it if 5432 is already in use
# locally, and match it in DATABASE_URL when connecting from the host.
DB_PORT=5432

# Signs the access_token returned by the login routes. Change this.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=365d

# HMAC-SHA256 request signature (the client's `Sig` header).
# Off by default: APP_KEY lives in libAudioEngine.so and is not shipped here.
# Set REQUIRE_SIG=true only once you have supplied your own APP_KEY.
REQUIRE_SIG=false
APP_KEY=
# Reject a request whose Current-Time is further than this from the server clock.
# Only consulted when REQUIRE_SIG=true. 0 disables the check.
SIG_MAX_SKEW_SECONDS=300

# Where uploaded audio/video/images land, and the base URL they are served under.
STORAGE_DIR=./storage
PUBLIC_URL=http://localhost:8080

# POST /v1/songs/downloadFromYoutube lets a client attach media to a song.
ALLOW_MEDIA_UPLOAD=true

# Max upload size in bytes (default 256 MiB) — recordings can be video.
MAX_UPLOAD_BYTES=268435456

LOG_LEVEL=info
